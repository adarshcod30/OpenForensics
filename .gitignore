# Local editor and tooling configuration
.claude/
.vscode/
.idea/

# Byte-compiled
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.DS_Store

# Environments
venv/ env/ .env .venv ENV/

# Dataset — 190k images, ~2 GB. See README for the download.
# Anchored with a leading slash: an unanchored `Dataset/` also matches
# `src/dataset/` on case-insensitive filesystems (macOS, Windows).
/Dataset/

# Run outputs. Weights are published to the Hugging Face Hub instead;
# a single training writes ~1.1 GB, most of it optimizer state.
runs/
*.keras
*.h5
*.hdf5
*.pb
logs/
tensorboard/
*.log

# Jupyter
.ipynb_checkpoints

# Local virtualenv (the project uses a conda env; see README)
venv/

# local agent and editor files, never committed
.claude.json
CLAUDE.local.md
CLAUDE.md
AGENTS.md
